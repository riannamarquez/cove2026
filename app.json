{
  "expo": {
    "name": "cove",
    "slug": "cove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cove_logo_transparent.png",
    "scheme": "cove",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.clairelu.cove",
      "buildNumber": "1",
      "icon": "./assets/images/cove_logo_transparent.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Cove needs camera access to evaluate your exercise form.",
        "NSPhotoLibraryUsageDescription": "Cove needs photo library access to save and review your form photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a2e1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a2e1a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Cove uses your camera to capture photos of your exercise form for AI feedback."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cove uses your camera to capture photos of your exercise form for AI feedback."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "131a7129-11d2-4142-a478-2772d7300e9d"
      }
    }
  }
}